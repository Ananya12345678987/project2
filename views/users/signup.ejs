<% layout("/layouts/boilerplate") %>

<style>
.auth-page{
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  width: 100vw;
  min-height: 82vh;
  background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.15) 40%, rgba(0,0,0,0.55) 100%),
              url("/images/auth-hero.jpg") center/cover no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem 1.5rem;
}

.auth-headline{
  position: absolute;
  top: 3rem;
  left: 3rem;
  color: #fff;
  max-width: 420px;
}

.auth-headline h2{
  font-weight: 700;
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

.auth-headline p{
  text-shadow: 0 1px 6px rgba(0,0,0,0.5);
}

.auth-card{
  background: rgba(255,255,255,0.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,0.4);
  border-radius: var(--radius-md);
  padding: 2.5rem;
  width: 100%;
  max-width: 400px;
  box-shadow: var(--shadow-md);
}

.auth-tabs{
  display: flex;
  gap: 1.5rem;
  margin-bottom: 1.75rem;
  border-bottom: 1px solid var(--color-border);
}

.auth-tabs a{
  text-decoration: none;
  color: var(--color-text-muted);
  font-weight: 600;
  padding-bottom: 0.6rem;
  border-bottom: 2px solid transparent;
}

.auth-tabs a.active{
  color: var(--color-text);
  border-bottom-color: var(--color-brand);
}

@media (max-width: 768px){
  .auth-page{
    min-height: 90vh;
    align-items: flex-end;
    padding-bottom: 2.5rem;
  }
  .auth-headline{
    top: 2rem;
    left: 1.5rem;
    right: 1.5rem;
    max-width: none;
  }
  .auth-card{
    max-width: 100%;
  }
}
</style>

<div class="auth-page">
  <div class="auth-headline">
    <h2>Join Wanderlust</h2>
    <p>List your space or find your next adventure in minutes.</p>
  </div>

  <div class="auth-card">
    <div class="auth-tabs">
      <a href="/login">Log in</a>
      <a href="/signup" class="active">Sign up</a>
    </div>

    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
        name="username"
        id="username"
        type="text"
        class="form-control"
        required/>
        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
        name="email"
        id="email"
        type="email"
        class="form-control"
        required/>
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
        name="password"
        id="password"
        type="password"
        class="form-control"
        required/>
        <div class="invalid-feedback">Please enter a password.</div>
      </div>

      <button class="btn add-btn w-100 mt-2">Sign up</button>
    </form>
  </div>
</div>
