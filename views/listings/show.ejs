<% layout("/layouts/boilerplate.ejs")%>

<style>
.show-wrap{
  max-width: 900px;
  margin: 0 auto;
}

.show-title{
  font-weight: 700;
}

.show-img{
  width: 100%;
  height: 22rem;
  object-fit: cover;
  border-radius: var(--radius-md);
}

.show-meta{
  color: var(--color-text-muted);
  margin-bottom: 1rem;
}

.show-price-bar{
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 0;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  margin: 1.5rem 0;
}

.show-price-bar .price{
  font-size: 1.4rem;
  font-weight: 700;
}

.host-row{
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 1.5rem 0;
}

.host-avatar{
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background-color: var(--color-brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}

.review-card{
  border: 1px solid var(--color-border) !important;
  border-radius: var(--radius-sm) !important;
  height: 100%;
}

.review-avatar{
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  background-color: var(--color-surface-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.review-header{
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.5rem;
}

.section-heading{
  margin-top: 2rem;
  margin-bottom: 1rem;
}
</style>

<div class="show-wrap mt-4">

  <h2 class="show-title"><%= listing.title %></h2>
  <p class="show-meta"><%= listing.location %>, <%= listing.country %></p>

  <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1560184897-ae75f418493e?auto=format&fit=crop&w=800&q=60' %>" class="show-img" alt="listing_image">

  <div class="show-price-bar">
    <span class="price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <small class="text-muted fw-normal">/ night</small></span>

    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) {%>
      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">Edit</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="mb-0">
          <button class="btn btn-outline-danger-soft">Delete</button>
        </form>
      </div>
    <% } %>

    <% if(currUser && (!listing.owner || !listing.owner._id.equals(currUser._id))){ %>
      <% const isWishlisted = currUser.wishlist && currUser.wishlist.some(id => id.equals(listing._id)); %>
      <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="mb-0">
        <button type="submit" class="btn btn-outline-danger-soft">
          <i class="<%= isWishlisted ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
          <%= isWishlisted ? 'Saved' : 'Save' %>
        </button>
      </form>
    <% } %>
  </div>

  <p><%= listing.description %></p>

  <% if(listing.owner){ %>
  <div class="host-row">
    <div class="host-avatar"><%= listing.owner.username.charAt(0).toUpperCase() %></div>
    <div>
      <div class="fw-semibold">Hosted by <%= listing.owner.username %></div>
    </div>
  </div>
  <% } %>

  <% if(currUser){ %>
    <h4 class="section-heading">Leave a Review</h4>
    <form action="/listings/<%= listing.id %>/reviews" method="Post" novalidate class="needs-validation">

      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio"
          id="no-rate"
          class="input-no-rate"
          name="review[rating]"
          value="0" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]"
        id="comment"
        cols="30"
        rows="6"
        class="form-control"
        required></textarea>
        <div class="invalid-feedback">Please submit a comment for the review</div>
      </div>

      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr />
  <% } %>

  <% if(listing.reviews.length > 0) { %>
    <h4 class="section-heading">All Reviews (<%= listing.reviews.length %>)</h4>
    <div class="row g-3">
      <% for(review of listing.reviews){%>
        <div class="col-md-6">
          <div class="card review-card">
            <div class="card-body">
              <div class="review-header">
                <div class="review-avatar"><%= review.author.username.charAt(0).toUpperCase() %></div>
                <div class="fw-semibold">@<%= review.author.username %></div>
              </div>
              <p class="starability-result card-text mb-1" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
              <p class="card-text"><%= review.comment %></p>

              <form
              class="mb-0"
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-danger-soft">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <div class="mb-5">
    <h3 class="section-heading">Where you'll be</h3>
    <div id="map" style="height: 400px;"></div>
  </div>

</div>

<script>
const listingCoordinates = <%- JSON.stringify(listing.geometry ? listing.geometry.coordinates : null) %>;
</script>

<script src="/js/map.js"></script>